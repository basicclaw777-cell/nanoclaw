      "script": "targets/hk_sentiment.py",
      "cron": "0 21 * * *",
      "cron_hkt": "5am daily",
      "enabled": true,
      "keywords": ["boxing", "gym", "fitness", "martial arts", "fight", "workout", "muay thai", "kickboxing", "self defence", "hong kong gym"],
      "sources": {
        "reddit": ["HongKong", "hongkong", "HongKongExpats"],
        "forums": ["geoexpat.com", "asiaexpat.com"]
      }
    },
    "competitor_gyms": {
      "script": "targets/competitor_gyms.py",
      "cron": "0 20 * * 0",
      "cron_hkt": "4am Sunday",
      "enabled": true,
      "gyms": [
        {"name": "Impakt MMA", "url": "https://www.impaktmma.com"},
        {"name": "Warrior Muay Thai", "url": "https://www.warriormuaythai.com"},
        {"name": "Fight Factory HK", "url": "https://www.fightfactoryhk.com"},
        {"name": "Krudar Muay Thai", "url": "https://www.krudar.com"},
        {"name": "BoxFit HK", "url": "https://www.boxfithk.com"},
        {"name": "UFC Gym HK", "url": "https://www.ufcgym.com.hk"},
        {"name": "Trinity MMA", "url": "https://www.trinitymma.com.hk"}
      ]
    },
