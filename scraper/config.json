        "TonyJeffriesBoxing", "FranSisto", "PrecisionStriking",
        "JTVanV", "ShaneBoxing", "CoachAnthony"
      ]
    },
    "corporate_leads": {
      "script": "targets/corporate_leads.py",
      "cron": "0 20 * * 1",
      "cron_hkt": "4am Monday",
